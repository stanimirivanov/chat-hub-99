# Server
OMOIKANE_ENV=local
OMOIKANE_SERVER_HOST=0.0.0.0
OMOIKANE_SERVER_PORT=3333
OMOIKANE_SERVER_VERSION=development
OMOIKANE_READINESS_TIMEOUT_MS=2000
OMOIKANE_ALLOWED_ORIGINS=http://localhost:4200
OTEL_EXPORTER_OTLP_ENDPOINT=
OMOIKANE_TELEMETRY_SHUTDOWN_TIMEOUT_MS=3000

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from-pnpm-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<local-only-from-pnpm-supabase-status>
