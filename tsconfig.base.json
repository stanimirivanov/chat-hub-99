{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "paths": {
      "@client/*": ["./apps/client/src/app/*"],
      "@client-environments/*": ["./apps/client/src/environments/*"],
      "@omoikane/shared/database": ["./libs/shared/database/src/index.ts"],
      "@omoikane/domain/channel": ["./libs/domain/channel/src/index.ts"],
      "@omoikane/domain/message": ["./libs/domain/message/src/index.ts"],
      "@omoikane/domain/profile": ["./libs/domain/profile/src/index.ts"],
      "@omoikane/domain/workspace": ["./libs/domain/workspace/src/index.ts"],
      "@omoikane/domain/analysis": ["./libs/domain/analysis/src/index.ts"],
      "@omoikane/application/authentication": [
        "./libs/application/authentication/src/index.ts"
      ],
      "@omoikane/application/channel": [
        "./libs/application/channel/src/index.ts"
      ],
      "@omoikane/application/message": [
        "./libs/application/message/src/index.ts"
      ],
      "@omoikane/application/profile": [
        "./libs/application/profile/src/index.ts"
      ],
      "@omoikane/application/workspace": [
        "./libs/application/workspace/src/index.ts"
      ],
      "@omoikane/application/analysis": [
        "./libs/application/analysis/src/index.ts"
      ],
      "@omoikane/infrastructure/message": [
        "./libs/infrastructure/message/src/index.ts"
      ],
      "@omoikane/infrastructure/profile": [
        "./libs/infrastructure/profile/src/index.ts"
      ],
      "@omoikane/infrastructure/channel": [
        "./libs/infrastructure/channel/src/index.ts"
      ],
      "@omoikane/infrastructure/authentication": [
        "./libs/infrastructure/authentication/src/index.ts"
      ],
      "@omoikane/infrastructure/workspace": [
        "./libs/infrastructure/workspace/src/index.ts"
      ],
      "@omoikane/infrastructure/analysis": [
        "./libs/infrastructure/analysis/src/index.ts"
      ]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": ["node_modules", "tmp"]
}
